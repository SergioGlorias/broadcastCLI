{
  "name": "libroadcast-cli",
  "version": "2.16.2",
  "description": "CLI to help with broadcast maintenance on Lichess",
  "keywords": [
    "broadcast",
    "cli",
    "lichess"
  ],
  "homepage": "https://github.com/SergioGlorias/broadcastCLI",
  "bugs": {
    "url": "https://github.com/SergioGlorias/broadcastCLI/issues"
  },
  "license": "MIT",
  "author": "Sérgio Glórias",
  "repository": {
    "type": "git",
    "url": "https://github.com/SergioGlorias/broadcastCLI.git"
  },
  "bin": {
    "libroadcast": "./dist/index.js"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "pnpm build && node ./dist/index.js",
    "format": "oxfmt ./src/**/*.ts ./package.json",
    "lint": "oxfmt --check ./src/**/*.ts ./package.json"
  },
  "dependencies": {
    "@lichess-org/types": "^2.0.171",
    "chessops": "^0.15.1",
    "dayjs": "^1.11.23",
    "ms": "3.0.0-canary.202508261828",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "~26.6.6",
    "oxfmt": "^0.77.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
